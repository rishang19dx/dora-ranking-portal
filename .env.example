# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Shared secret used by the Python scraper to invalidate Next.js data caches.
REVALIDATION_SECRET="replace-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# Data collection workflow (organogram requests, nodal officer portal access)
# ---------------------------------------------------------------------------

# Directory for the file-backed portal store, proof uploads and the local mail
# outbox. Defaults to ".data" in the project root.
# PORTAL_DATA_DIR=".data"

# Base URL used to build the restricted upload links sent to nodal officers.
# Falls back to APP_URL, then http://localhost:3000.
APP_BASE_URL="http://localhost:3000"

# How long a provisioned upload link stays valid, in days (default 45).
# PORTAL_ACCESS_TTL_DAYS="45"

# Email transport. Without RESEND_API_KEY, dispatched messages are written to
# <PORTAL_DATA_DIR>/outbox/ and reported as SIMULATED instead of being sent.
# RESEND_API_KEY="re_..."
MAIL_FROM="DORA Office <dora@iitmandi.ac.in>"

# ---------------------------------------------------------------------------
# Security & access control (Phase 3)
# ---------------------------------------------------------------------------

# Required whenever DJANGO_DEBUG is off: every login token is signed with it,
# and the backend refuses to start with the built-in development key.
# DJANGO_SECRET_KEY="replace-with-a-long-random-string"
# DJANGO_DEBUG="False"

# Comma-separated host names / origins for production. With DEBUG on and
# these unset, any host and any origin are accepted for local development.
# DJANGO_ALLOWED_HOSTS="ranking.iitmandi.ac.in"
# CORS_ALLOWED_ORIGINS="https://ranking.iitmandi.ac.in"
# CSRF_TRUSTED_ORIGINS="https://ranking.iitmandi.ac.in"

# With DEBUG off, SSL redirect, secure cookies and HSTS are on by default.
# Relax them only on a plain-HTTP staging host (docs/runbooks/configuration.md):
# DJANGO_SECURE_SSL_REDIRECT="False"
# DJANGO_SECURE_COOKIES="False"

# Failed-login throttle on /api/auth/token/ (default 10/min per client).
# LOGIN_THROTTLE_RATE="10/min"

# Bootstrap admin created/repaired by `manage.py ensure_admin` (run by
# scripts/deploy.sh). The password is mandatory with DEBUG off; other
# accounts and their roles are managed in the portal under Users & Roles.
# DORA_ADMIN_USERNAME="admin"
# DORA_ADMIN_PASSWORD="choose-a-strong-password"
# DORA_ADMIN_EMAIL="dora@iitmandi.ac.in"

# ---------------------------------------------------------------------------
# Automated deadline reminders (`manage.py send_reminders`, run hourly by
# cron from scripts/deploy.sh or by the compose `reminders` service)
# ---------------------------------------------------------------------------
# Days before each request's deadline to remind sections still pending.
# REMINDER_DAYS_BEFORE="7,3,1"
# After the deadline: chase every N days, at most M times.
# REMINDER_OVERDUE_INTERVAL_DAYS="3"
# REMINDER_OVERDUE_MAX="3"
# Skip an automated reminder if DORA reminded the section by hand this recently.
# REMINDER_MANUAL_COOLDOWN_HOURS="20"

# ---------------------------------------------------------------------------
# AI-assisted discrepancy review (optional)
# ---------------------------------------------------------------------------
# Rule-based discrepancy flags always work. Set a provider and key to add an
# AI second opinion on the open flags (Admin > Discrepancies > "Scan + AI
# review"). Only aggregated, PII-free figures are sent, replies quoting
# figures not in the data are rejected, and every call is logged.
#
# AI_PROVIDER: openai | openrouter | anthropic | gemini | openai-compatible
#   openai-compatible = any server speaking the OpenAI chat-completions API
#   (self-hosted vLLM/Ollama, Groq, Together, Azure ...); set AI_BASE_URL.
AI_PROVIDER=""
# The provider's API key.
AI_API_KEY=""
# Model id. Defaults if unset: openai gpt-4o-mini, openrouter openrouter/auto,
# anthropic claude-haiku-5-5, gemini gemini-2.0-flash. Pinning one is recommended.
# AI_MODEL=""
# Override the endpoint (required for openai-compatible), e.g.
# AI_BASE_URL="http://localhost:11434/v1"
# AI_TIMEOUT_SECONDS="30"
# Most flags sent per review (critical first).
# AI_MAX_FLAGS="60"

# Rule thresholds (percent) for discrepancy flags.
# DISCREPANCY_CRITICAL_DROP_PCT="80"
# DISCREPANCY_CRITICAL_RISE_PCT="300"
# DISCREPANCY_WARNING_CHANGE_PCT="40"
# DISCREPANCY_RESTATE_CRITICAL_PCT="50"
# DISCREPANCY_RESTATE_WARNING_PCT="5"
# DISCREPANCY_RECORD_WARNING_PCT="50"
