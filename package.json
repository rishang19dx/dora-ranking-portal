{
  "name": "iit-mandi-ranking-portal",
  "version": "2.0.0",
  "private": true,
  "description": "IIT Mandi DORA Ranking Portal - React SPA + Django REST Framework",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "deploy": "./scripts/deploy.sh",
    "dev:backend": "cd backend && ./venv/bin/python manage.py runserver 0.0.0.0:8000",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "test": "cd backend && ./venv/bin/pytest tests/ && cd ../frontend && npm run build",
    "test:backend": "cd backend && ./venv/bin/pytest tests/ -v",
    "test:frontend": "cd frontend && npm run build",
    "backend:migrate": "cd backend && ./venv/bin/python manage.py migrate",
    "backend:seed": "cd backend && ./venv/bin/python manage.py seed_organogram",
    "backend:scrape": "cd backend && ./venv/bin/python manage.py scrape_nirf"
  }
}
